# Copy to .env (never commit it). fedreg-digest reads it from the current directory.

# Claude, for relevance reviews and summaries: https://console.anthropic.com/
# Without it, runs use keyword scoring only.
ANTHROPIC_API_KEY=

# Email delivery (only needed when email.enabled is true in your profile).
# Gmail: smtp.gmail.com, port 587, and an app password (https://myaccount.google.com/apppasswords).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Optional: From address, if different from SMTP_USERNAME
SMTP_FROM=
# Comma-separated recipients. Overrides email.to in the profile.
FEDREG_EMAIL_TO=

# Optional: profile to use when -p is not given (default ./fedreg.yaml)
# FEDREG_PROFILE=profiles/food-labeling.yaml
